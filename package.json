{
  "name": "nova-wing",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    "./core": {
      "types": "./packages/core/src/index.ts",
      "import": "./dist/packages/core/src/index.js"
    },
    "./sqlite": {
      "types": "./packages/sqlite/src/index.ts",
      "import": "./dist/packages/sqlite/src/index.js"
    },
    "./testing": {
      "types": "./packages/testing/src/index.ts",
      "import": "./dist/packages/testing/src/index.js"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "npm run build && node --test --test-concurrency=1 \"dist/tests/*.test.js\"",
    "test:domain": "npm run build && node --test --test-concurrency=1 dist/tests/domain.test.js",
    "check:unused": "tsc -p tsconfig.json --noEmit --noUnusedLocals --noUnusedParameters",
    "check:migration": "npm run build && node scripts/verify-migration.mjs",
    "check:exports": "npm run build && node scripts/check-package-exports.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run check:unused && npm run check:migration && npm run check:exports && npm run check:boundaries"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@types/node": "24.10.1",
    "eslint": "9.39.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1"
  }
}
