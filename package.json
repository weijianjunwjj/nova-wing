{
  "name": "nova-wing",
  "version": "0.1.0",
  "description": "NovaWing standalone approved-mainline kernel and snapshot contracts",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist/packages/**",
    "README.md"
  ],
  "exports": {
    "./core": {
      "types": "./dist/packages/core/src/index.d.ts",
      "import": "./dist/packages/core/src/index.js"
    },
    "./development-guardian": {
      "types": "./dist/packages/development-guardian/index.d.ts",
      "import": "./dist/packages/development-guardian/index.js"
    },
    "./sqlite": {
      "types": "./dist/packages/sqlite/src/index.d.ts",
      "import": "./dist/packages/sqlite/src/index.js"
    },
    "./testing": {
      "types": "./dist/packages/testing/src/index.d.ts",
      "import": "./dist/packages/testing/src/index.js"
    },
    "./host-snapshot": {
      "types": "./dist/packages/host-snapshot/src/index.d.ts",
      "import": "./dist/packages/host-snapshot/src/index.js"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node scripts/clean-output.mjs dist && tsc -p tsconfig.build.json",
    "build:tests": "node scripts/clean-output.mjs dist-tests && tsc -p tsconfig.tests.json",
    "desktop:dev": "npm run build && node scripts/desktop-dev.mjs",
    "desktop:smoke": "npm run build && node scripts/desktop-smoke.mjs",
    "check:desktop": "node scripts/run-isolated-tests.mjs \"desktop/tests/*.test.mjs\"",
    "benchmark:v1v2": "node dist-tests/tests/benchmark/run-benchmark.js",
    "benchmark:v028": "npm run build:tests && node dist-tests/tests/benchmark/run-architecture-benchmark.js",
    "benchmark:planning-quality": "npm run build && node scripts/planning-quality-benchmark.mjs",
    "dogfood:v028": "npm run build && node scripts/dogfood-v028-direct-path.mjs",
    "reliability:v030": "npm run build && node scripts/v030-golden-path-reliability.mjs",
    "certify:v0.2": "npm run build && npm run build:tests && node dist-tests/tests/certification/v0.2/run-certification.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && npm run build:tests && node scripts/run-isolated-tests.mjs --test-concurrency=1 \"dist-tests/tests/*.test.js\"",
    "test:domain": "npm run build && npm run build:tests && node scripts/run-isolated-tests.mjs --test-concurrency=1 dist-tests/tests/domain.test.js",
    "check:unused": "tsc -p tsconfig.json --noEmit --noUnusedLocals --noUnusedParameters && tsc -p tsconfig.desktop.json",
    "check:migration": "npm run build && node scripts/verify-migration.mjs",
    "check:exports": "npm run build && node scripts/check-package-exports.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "consumer:selftest": "node scripts/consumer-selftest.mjs",
    "release:prepare": "node scripts/release-prepare.mjs",
    "release:inspect": "node scripts/release-inspect.mjs",
    "release:selftest": "node scripts/release-selftest.mjs",
    "guardian:chatgpt:install": "npm run build && node scripts/install-ask-bridge.mjs",
    "guardian:chatgpt:login": "npm run build && node scripts/guardian-ask-bridge-login.mjs",
    "guardian:chatgpt:poc": "npm run build && node scripts/guardian-chatgpt-poc.mjs",
    "guardian:poc": "npm run build && node scripts/guardian-loop-poc.mjs",
    "guardian:poc:canary": "npm run build && node scripts/guardian-full-loop-canary.mjs",
    "guardian:work-session:ui": "npm run build && node scripts/guardian-work-session-ui.mjs",
    "guardian:launchpad": "npm run build && node scripts/guardian-launchpad.mjs",
    "guardian:work-session:adopt": "npm run build && node scripts/guardian-work-session-adopt.mjs",
    "guardian:notification:setup": "npm run build && node scripts/guardian-notification-setup.mjs",
    "guardian:repair-notification:smoke": "npm run build && node scripts/guardian-repair-notification-smoke.mjs",
    "guardian:notification-channel:smoke": "npm run build && node scripts/novawing-notification-channel-smoke.mjs",
    "guardian:quota-inject": "npm run build && node scripts/guardian-controlled-quota-injection.mjs",
    "analytics:backfill": "npm run build && node scripts/analytics-backfill.mjs",
    "check": "npm run typecheck && npm run test && npm run check:unused && npm run check:migration && npm run check:exports && npm run check:boundaries && npm run check:platform && npm run check:desktop",
    "check:platform": "node scripts/check-platform-boundaries.mjs",
    "desktop:package:dir": "npm run build && node scripts/platform/windows-package.mjs",
    "desktop:package:mac": "npm run build && node scripts/platform/macos-package.mjs",
    "desktop:package:mac:dist": "npm run build && node scripts/platform/macos-package.mjs --dist",
    "desktop:package:smoke": "node scripts/desktop-package-smoke.mjs",
    "desktop:build:win": "node scripts/platform/windows-package.mjs --installer",
    "third-party:notices": "node scripts/third-party-notices.mjs"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/nodemailer": "^8.0.1",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@mastra/core": "^1.60.0",
    "@mastra/libsql": "^1.21.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@openai/codex-sdk": "0.157.0",
    "electron-updater": "6.8.9",
    "nodemailer": "^9.0.5",
    "zod": "^4.4.3"
  }
}
