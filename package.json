{
  "name": "nova-wing",
  "version": "0.1.0",
  "description": "NovaWing standalone approved-mainline kernel and snapshot contracts",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist/packages/**",
    "README.md"
  ],
  "exports": {
    "./core": {
      "types": "./dist/packages/core/src/index.d.ts",
      "import": "./dist/packages/core/src/index.js"
    },
    "./development-guardian": {
      "types": "./dist/packages/development-guardian/index.d.ts",
      "import": "./dist/packages/development-guardian/index.js"
    },
    "./sqlite": {
      "types": "./dist/packages/sqlite/src/index.d.ts",
      "import": "./dist/packages/sqlite/src/index.js"
    },
    "./testing": {
      "types": "./dist/packages/testing/src/index.d.ts",
      "import": "./dist/packages/testing/src/index.js"
    },
    "./host-snapshot": {
      "types": "./dist/packages/host-snapshot/src/index.d.ts",
      "import": "./dist/packages/host-snapshot/src/index.js"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "node scripts/clean-output.mjs dist && tsc -p tsconfig.build.json",
    "build:tests": "node scripts/clean-output.mjs dist-tests && tsc -p tsconfig.tests.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && npm run build:tests && node --test --test-concurrency=1 \"dist-tests/tests/*.test.js\"",
    "test:domain": "npm run build && npm run build:tests && node --test --test-concurrency=1 dist-tests/tests/domain.test.js",
    "check:unused": "tsc -p tsconfig.json --noEmit --noUnusedLocals --noUnusedParameters",
    "check:migration": "npm run build && node scripts/verify-migration.mjs",
    "check:exports": "npm run build && node scripts/check-package-exports.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "pack:check": "node scripts/pack-check.mjs",
    "consumer:selftest": "node scripts/consumer-selftest.mjs",
    "release:prepare": "node scripts/release-prepare.mjs",
    "release:inspect": "node scripts/release-inspect.mjs",
    "release:selftest": "node scripts/release-selftest.mjs",
    "guardian:chatgpt:install": "bash scripts/install-ask-bridge.sh",
    "guardian:chatgpt:login": "node scripts/guardian-ask-bridge-login.mjs",
    "guardian:chatgpt:poc": "npm run build && node scripts/guardian-chatgpt-poc.mjs",
    "guardian:poc": "npm run build && node scripts/guardian-loop-poc.mjs",
    "guardian:poc:canary": "npm run build && node scripts/guardian-full-loop-canary.mjs",
    "check": "npm run typecheck && npm run test && npm run check:unused && npm run check:migration && npm run check:exports && npm run check:boundaries"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
