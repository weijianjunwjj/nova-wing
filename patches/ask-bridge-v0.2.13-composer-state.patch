+fn safe_prompt_fingerprint(prompt: &str) -> String {
+    let mut hash = 0xcbf29ce484222325_u64;
+    for byte in prompt.as_bytes() {
+        hash ^= u64::from(*byte);
+        hash = hash.wrapping_mul(0x100000001b3);
+    }
+    format!("fnv1a64-{hash:016x}")
+}
+
+fn safe_conversation_fingerprint(identity: &str) -> String {
+    format!("conversation-{}", safe_prompt_fingerprint(identity))
+}
+
+fn canonical_conversation_identity(provider: Provider, raw_url: &str) -> Option<String> {
+    let url = Url::parse(raw_url).ok()?;
+    if !provider.owns_conversation_url(&url) {
+        return None;
+    }
+    let segments: Vec<&str> = url
+        .path_segments()?
+        .filter(|segment| !segment.is_empty())
+        .collect();
+    let marker = provider.conversation_marker();
+    let id = segments
+        .windows(2)
+        .find(|parts| parts[0] == marker && !parts[1].is_empty())?[1];
+    if provider == Provider::ChatGpt && id.starts_with("WEB:") {
+        return None;
+    }
+    Some(format!("{}:{id}", provider.conversation_namespace()))
+}
+
+fn provisional_conversation_identity() -> String {
+    let timestamp = SystemTime::now()
+        .duration_since(UNIX_EPOCH)
+        .unwrap_or_default()
+        .as_nanos();
+    format!("provisional:{}:{timestamp}", std::process::id())
+}
+
+fn submission_storage_key(operation_id: &str, conversation_fingerprint: &str) -> String {
+    format!("ask-bridge-submission:v2:{operation_id}:{conversation_fingerprint}")
+}
+
+fn current_page_url(config_path: &str) -> Option<String> {
+    call_mcp_tool(
+        config_path,
+        "evaluate_script",
+        serde_json::json!({ "function": "() => window.location.href" }),
+    )
+    .ok()
+    .and_then(|value| parse_script_result(&value).ok())
+    .and_then(|value| value.as_str().map(str::to_string))
+}
+
+fn migrate_submission_to_canonical_conversation(
+    config_path: &str,
+    operation_id: &str,
+    prompt_fingerprint: &str,
+    previous_conversation_fingerprint: &str,
+    canonical_conversation_fingerprint: &str,
+) -> Result<(), String> {
+    if previous_conversation_fingerprint == canonical_conversation_fingerprint {
+        return Ok(());
+    }
+    let previous_key = submission_storage_key(operation_id, previous_conversation_fingerprint);
+    let canonical_key = submission_storage_key(operation_id, canonical_conversation_fingerprint);
+    let script = r#"() => {
+            const previousKey = __PREVIOUS_KEY__;
+            const canonicalKey = __CANONICAL_KEY__;
+            const operationId = __OPERATION_ID__;
+            const promptFingerprint = __PROMPT_FINGERPRINT__;
+            const canonicalConversationFingerprint = __CANONICAL_FINGERPRINT__;
+            const parse = (key) => {
+                try { return JSON.parse(localStorage.getItem(key) || 'null'); }
+                catch (e) { return null; }
+            };
+            const previous = parse(previousKey);
+            const existing = parse(canonicalKey);
+            const state = previous || existing;
+            if (!state || state.operationId !== operationId ||
+                state.promptFingerprint !== promptFingerprint) {
+                return { ok: false, reason: 'submission state unavailable for canonical migration' };
+            }
+            if (existing && previous &&
+                existing.submissionGeneration !== previous.submissionGeneration) {
+                return { ok: false, reason: 'canonical conversation has a different submission generation' };
+            }
+            state.conversationIdentityHash = canonicalConversationFingerprint;
+            state.conversationIdentityKnown = true;
+            localStorage.setItem(canonicalKey, JSON.stringify(state));
+            if (previousKey !== canonicalKey) localStorage.removeItem(previousKey);
+            return { ok: true };
+        }"#
+    .replace("__PREVIOUS_KEY__", &serde_json::to_string(&previous_key).unwrap())
+    .replace("__CANONICAL_KEY__", &serde_json::to_string(&canonical_key).unwrap())
+    .replace("__OPERATION_ID__", &serde_json::to_string(operation_id).unwrap())
+    .replace(
+        "__PROMPT_FINGERPRINT__",
+        &serde_json::to_string(prompt_fingerprint).unwrap(),
+    )
+    .replace(
+        "__CANONICAL_FINGERPRINT__",
+        &serde_json::to_string(canonical_conversation_fingerprint).unwrap(),
+    );
+    let result = call_mcp_tool(
+        config_path,
+        "evaluate_script",
+        serde_json::json!({ "function": script }),
+    )?;
+    let parsed = parse_script_result(&result)?;
+    if parsed.get("ok").and_then(Value::as_bool) == Some(true) {
+        Ok(())
+    } else {
+        Err(parsed
+            .get("reason")
+            .and_then(Value::as_str)
+            .unwrap_or("canonical conversation migration failed")
+            .to_string())
+    }
+}
+
+fn finalize_submission_conversation(
+    config_path: &str,
+    provider: Provider,
+    operation_id: &str,
+    prompt_fingerprint: &str,
+    initial_conversation_fingerprint: &str,
+    initial_conversation_known: bool,
+    status: String,
+    timeout: Duration,
+) -> Result<String, String> {
+    let Some(raw_metrics) = status.strip_prefix("success:") else {
+        return Ok(status);
+    };
+    if initial_conversation_known {
+        return Ok(status);
+    }
+    let started_at = Instant::now();
+    while started_at.elapsed() < timeout {
+        let canonical_fingerprint = current_page_url(config_path)
+            .and_then(|url| canonical_conversation_identity(provider, &url))
+            .map(|identity| safe_conversation_fingerprint(&identity));
+        if let Some(canonical_fingerprint) = canonical_fingerprint {
+            let mut metrics = serde_json::from_str::<Value>(raw_metrics).map_err(|_| {
+                "submission metrics were invalid after successful submit".to_string()
+            })?;
+            let metrics_fingerprint = metrics
+                .get("conversationIdentityHash")
+                .and_then(Value::as_str)
+                .unwrap_or(initial_conversation_fingerprint);
+            migrate_submission_to_canonical_conversation(
+                config_path,
+                operation_id,
+                prompt_fingerprint,
+                metrics_fingerprint,
+                &canonical_fingerprint,
+            )?;
+            metrics["conversationIdentityHash"] = Value::String(canonical_fingerprint);
+            return Ok(format!("success:{}", metrics));
+        }
+        thread::sleep(std::cmp::min(
+            Duration::from_millis(100),
+            timeout.saturating_sub(started_at.elapsed()),
+        ));
+    }
+    Err(format!(
+        "canonical conversation identity unavailable after submission submissionMetrics={raw_metrics}"
+    ))
+}
