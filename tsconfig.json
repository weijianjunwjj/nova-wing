{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "baseUrl": ".",
    "paths": {
      "nova-wing/core": ["packages/core/src/index.ts"],
      "nova-wing/host-snapshot": ["packages/host-snapshot/src/index.ts"],
      "nova-wing/sqlite": ["packages/sqlite/src/index.ts"],
      "nova-wing/testing": ["packages/testing/src/index.ts"],
      "nova-wing/dev-guardian": ["packages/dev-guardian/src/index.ts"]
    },
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["packages/**/*.ts", "tests/**/*.ts"]
}
